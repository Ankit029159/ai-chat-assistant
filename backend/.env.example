# Copy this file to `.env` and fill in real API keys. Do NOT commit `.env` with real secrets.
# Example:
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

GEMINI_API_KEY=
OPENAI_API_KEY=
# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Configuration (for embeddings via LangChain)
OPENAI_API_KEY=your_openai_api_key_here

# ChromaDB Configuration
CHROMA_PERSIST_DIR=./chroma_db

# Chunk Configuration (for document splitting)
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Server Configuration
PORT=8000

# Optional: Safety & Logging
DEBUG=true
LOG_LEVEL=INFO
